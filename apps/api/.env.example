# Copy to apps/api/.env for local development. Never commit the real .env.
# Production secrets live in the server's secret store (see docs/adr/0002-backend-foundation.md).
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# PostgreSQL: docker compose (port 5432) or `pnpm --filter @omnibot/api db:local` (port 5433, no Docker needed)
DATABASE_URL=postgresql://omnibot:omnibot@localhost:5432/omnibot
REDIS_URL=redis://localhost:6379

# 32+ random characters each: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32-byte key, base64: openssl rand -base64 32  (encrypts channel/ads tokens at rest)
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Comma-separated browser origins allowed to call the API (web app, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
RATE_LIMIT_PER_MINUTE=120
# Per IP and per route on credential endpoints (login, register, forgot-password...)
AUTH_RATE_LIMIT_PER_MINUTE=10

# Web app base URL used in email links
APP_URL=http://localhost:5173

# Email. Without SMTP_URL, development writes emails to apps/api/.outbox (production requires SMTP).
MAIL_FROM=OmniBot <no-reply@omnibot.vn>
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Cloudflare Turnstile secret (required in production). Unset in development: any non-empty captcha token passes.
# TURNSTILE_SECRET_KEY=
