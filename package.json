{
  "name": "omnibot",
  "private": true,
  "description": "OmniBot – Chatbot AI, Livechat đa kênh, CRM, Quảng cáo & POS",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @omnibot/web dev",
    "dev:ai": "pnpm --filter @omnibot/ai-server start",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && pnpm --filter @omnibot/mobile lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
